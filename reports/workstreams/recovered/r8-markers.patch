+def reviewed_panel(ref: str):
+    """The panel this probe reviewed, materialised from git blobs.
+
+    Two of the probe's claims are about the committed archives, and the panel
+    those archives were run against is no longer the one in the tree: A20
+    regenerated the nine within-graph cells and the manifest moved from
+    15e588a86c12 to ee1362df3f09. Reading the blobs rather than a checkout keeps
+    the check independent of the host line-ending policy, which rewrites this
+    tree to CRLF.
+    """
+    root = Path(tempfile.mkdtemp(prefix="ad01-bdf-review-panel-"))
+    listing = subprocess.check_output(
+        ["git", "ls-tree", "-r", "--name-only", ref, WORLDS_DIR],
+        cwd=ROOT, text=True)
+    for name in listing.split():
+        target = root / name
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(subprocess.check_output(
+            ["git", "cat-file", "-p", "%s:%s" % (ref, name)], cwd=ROOT))
+    panel = root / WORLDS_DIR
+    assert not worlds.verify_freeze(panel), worlds.verify_freeze(panel)
+    return root
+
 
