+def is_marker(path: Path | str) -> bool:
+    return Path(path).name.endswith(MARKER_SUFFIX)
+
+
+def artifact_paths(directory: Path | str, pattern: str = "*.json") -> list[Path]:
+    """`glob(pattern)` over `directory`, minus the supersession markers.
+
+    A marker is a sibling of an artifact and carries its stem, so a reader
+    globbing the artifact's own family matches the marker too. Every reader
+    of these trees goes through here, so "a marker is not an artifact" is one
+    rule rather than one exclusion per reader.
+    """
+    return sorted(p for p in Path(directory).glob(pattern) if not is_marker(p))
+
+
