# Copy to an untracked location and fill in. Never commit filled values.
SETTLEMENT_DSN=postgresql://ubuntu@/settlement?host=/var/run/postgresql
SETTLEMENT_GATEWAY_ENDPOINT=
# Environment variable holding the gateway bearer key (the key itself stays out of git).
# scripts/manifest.py never prints it; src/settlement/gateway_http.py reads it via
# GatewayConfig.api_key_env.
SETTLEMENT_GATEWAY_KEY=
SETTLEMENT_ARTIFACT_ROOT=var/artifacts
SETTLEMENT_STAGING_ROOT=var/staging
